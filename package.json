{
  "name": "cue-assistant",
  "version": "1.0.0",
  "description": "A personal interview and meeting assistant with your own AI account.",
  "author": "Cue contributors",
  "main": "main.js",
  "scripts": {"start": "electron .", "test": "node --test test/*.test.js", "build": "electron-builder --win --x64"},
  "dependencies": {"ws": "^8.20.0"},
  "devDependencies": {"electron": "35.7.5", "electron-builder": "26.8.1"},
  "build": {
    "appId": "app.cue.assistant", "productName": "Cue", "asar": true,
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "package.json", "icon.png"],
    "directories": {"output": "release"},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}], "icon": "icon.ico"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Cue-Setup-${version}.exe"},
    "portable": {"artifactName": "Cue-Portable-${version}.exe"}
  }
}
